{
  "name": "@simplia/agent-chat-adapter-acv2",
  "version": "0.1.0",
  "private": true,
  "description": "ACV2 durable-event adapter and provider profiles for Simplia Agent Chat.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruia-app/simplia-agent-chat.git",
    "directory": "packages/agent-chat-adapter-acv2"
  },
  "homepage": "https://github.com/gruia-app/simplia-agent-chat#readme",
  "bugs": "https://github.com/gruia-app/simplia-agent-chat/issues",
  "keywords": ["agent", "chat", "acv2", "codex", "cli", "typescript"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@simplia/agent-chat-core": "workspace:^",
    "simplia-agent-chat": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
