{
  "name": "@simplia/agent-chat-react",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible React shell and trusted surface registry for Simplia Agent Chat.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruia-app/simplia-agent-chat.git",
    "directory": "packages/agent-chat-react"
  },
  "homepage": "https://github.com/gruia-app/simplia-agent-chat#readme",
  "bugs": "https://github.com/gruia-app/simplia-agent-chat/issues",
  "keywords": ["agent", "chat", "react", "accessibility", "codex", "typescript"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@simplia/agent-chat-core": "workspace:^",
    "simplia-agent-chat": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.6.3"
  }
}
